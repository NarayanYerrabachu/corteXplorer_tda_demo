# CorteXplorer TDA Demo — Government Aid Edition
# Copy to .env and fill in values

# Primary data source (runtime)
GOV_AID_API_URL=http://localhost:8003/gov-aid-report

# Local dataset fallback (used if API is unavailable or for PDF generation)
GOV_AID_EXCEL_PATH=/Users/narayanyerrabachu/Downloads/Datenanalyse_Gov_Cleaned_MH.xlsx
GOV_AID_SHEET=government_aid_projects_v3

# Server
PORT=8010
HOST=0.0.0.0

# LLM (optional — enables AI report + chat summaries)
OPENAI_API_KEY=

# TDA configuration
TDA_SAMPLE_N=3000
TDA_CONTAMINATION=0.03
TDA_DBSCAN_EPS=0.9
TDA_DBSCAN_MIN_SAMPLES=5
